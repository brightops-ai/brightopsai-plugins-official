#!/bin/sh
# Runs the secret-scan gate on the commit an automatic merge creates.
#
# Git does not run pre-commit for `git merge`; it runs this hook instead. The
# gate itself lives in .githooks/pre-commit, next to this file. If that file
# cannot be run, `exec` fails and the merge commit is blocked.

case "$0" in
  */*) dir="${0%/*}" ;;
  *) dir="." ;;
esac

exec "$dir/pre-commit" pre-merge-commit
